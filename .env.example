# Apple Developer 팀 ID
TEAM_ID=XXXXXXXXXX

# MusicKit 키 ID (.p8 파일에 대응)
KEY_ID=XXXXXXXXXX

# .p8 개인 키 경로.
#
# 로컬 개발: 비워 두면 실행 디렉터리의 AuthKey_*.p8 을 자동으로 찾습니다.
#            키가 여러 개면 자동 선택하지 않으니 하나를 지정해 주세요.
#
# 서버(도커): 키는 이미지에 굽지 않고 /data/apple_music_playlist 를 마운트합니다.
#            아래처럼 절대 경로로 지정하세요.
#            PRIVATE_KEY_PATH=/data/apple_music_playlist/AuthKey_XXXXXXXXXX.p8
PRIVATE_KEY_PATH=

# 리스닝 포트
PORT=8002

# CORS 허용 오리진 (쉼표 구분)
ALLOWED_ORIGINS=https://playlist.gowoobro.com,http://localhost:9002
